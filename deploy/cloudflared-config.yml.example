# PLACEHOLDER TEMPLATE: do not install over an existing tunnel configuration.
# Adapt only an approved route after configuring Access Managed OAuth and
# origin JWT validation. Preserve unrelated ingress and fallback ordering.
ingress:
  - hostname: research.example.com
    path: ^/mcp$
    service: http://reverse-proxy.example:80
