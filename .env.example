# Placeholder paths only. Create these directories yourself before launch.
GROK_MCP_STAGING_ROOT=C:\path\to\grok-staging
GROK_MCP_INBOX_DIR=C:\path\to\grok-staging\Grok Research Inbox
GROK_MCP_AUDIT_DIR=C:\path\to\grok-staging\service-audit

# Local smoke testing only. The server remains bound to 127.0.0.1.
GROK_MCP_AUTH_MODE=local-development

# Required before a Cloudflare Tunnel is connected. Replace local-development
# with cloudflare-access and provide both values from the Access application.
# GROK_MCP_AUTH_MODE=cloudflare-access
# GROK_MCP_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# GROK_MCP_ACCESS_AUD=replace-with-access-application-aud

# Optional comma-separated HTTPS origins. Requests with an Origin header are
# rejected unless the exact origin is listed. Non-browser MCP clients may omit it.
# GROK_MCP_ALLOWED_ORIGINS=https://mcp.example.com

# Required in cloudflare-access mode so the origin rejects unexpected Host values.
# GROK_MCP_ALLOWED_HOSTS=mcp.example.com

# Optional bounded overrides.
# GROK_MCP_PORT=3100
# GROK_MCP_MAX_REQUEST_BYTES=131072
# GROK_MCP_MAX_RESEARCH_BYTES=50000
# GROK_MCP_MAX_NOTE_BYTES=65536
# GROK_MCP_REQUESTS_PER_MINUTE=120
# GROK_MCP_ENABLE_LIST_SUBMISSIONS=true
